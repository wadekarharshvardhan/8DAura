      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ResetSettingsButton" Content="Reset to defaults" Visibility="Collapsed" Padding="12,7" Margin="0,0,10,0" Click="ResetSettingsButton_Click"/><Border Background="#18251F" CornerRadius="14" Padding="12,7"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#758093" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="ENGINE OFFLINE" Foreground="#B9C6D8" FontSize="11" FontWeight="SemiBold"/></StackPanel></Border></StackPanel>
    </DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#E0161E2A" CornerRadius="24" Padding="24" Margin="0,0,18,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel><TextBlock Text="SOUND POSITION" FontSize="12" FontWeight="Bold" Foreground="#AEBBD0"/><TextBlock x:Name="PositionText" DockPanel.Dock="Right" Margin="10,0,0,0" Text="FRONT" FontSize="11" Foreground="#69A7FF"/></DockPanel>
          <Viewbox Grid.Row="1" Stretch="Uniform" Margin="4,8,4,0"><Canvas x:Name="OrbitCanvas" Width="500" Height="440" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OrbitCanvas_MouseLeftButtonDown" MouseMove="OrbitCanvas_MouseMove" MouseLeftButtonUp="OrbitCanvas_MouseLeftButtonUp">
