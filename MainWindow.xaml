            <Ellipse Canvas.Left="111" Canvas.Top="80" Width="3" Height="3" Fill="#72D7FF" Opacity="0.9" IsHitTestVisible="False"/><Ellipse Canvas.Left="369" Canvas.Top="106" Width="2.5" Height="2.5" Fill="#9B82FF" Opacity="0.9" IsHitTestVisible="False"/><Ellipse Canvas.Left="122" Canvas.Top="333" Width="2.5" Height="2.5" Fill="#8AB8FF" Opacity="0.75" IsHitTestVisible="False"/><Ellipse Canvas.Left="354" Canvas.Top="350" Width="3" Height="3" Fill="#9278FF" Opacity="0.8" IsHitTestVisible="False"/>
            <Ellipse IsHitTestVisible="False" x:Name="OrbitDot" Canvas.Left="245" Canvas.Top="15" Width="10" Height="10" Fill="#FFFFFF" Stroke="#69A7FF" StrokeThickness="3"/>
            <Ellipse IsHitTestVisible="False" x:Name="OrbitGlow" Canvas.Left="237" Canvas.Top="7" Width="26" Height="26" Fill="#356FC7" Opacity="0.20"/>
          </Canvas></Viewbox>
          <StackPanel Grid.Row="2" Margin="0,8,0,0"><TextBlock Text="DRAG THE DOT TO MOVE THE SOUND" FontSize="10" Foreground="#74B5FF" Margin="0,0,0,8"/><TextBlock Text="ORBIT SPEED" FontSize="11" FontWeight="SemiBold" Foreground="#AEBBD0"/><Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><Slider x:Name="SpeedSlider" Grid.Column="0" Minimum="0.05" Maximum="0.8" SmallChange="0.01" LargeChange="0.05" Value="0.22"/><Border Grid.Column="1" Background="#222E3E" BorderBrush="#35465C" CornerRadius="10" Padding="8,5" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="SpeedText" Text="0.22 Hz" HorizontalAlignment="Center" Foreground="#8CC4FF" FontWeight="SemiBold"/></Border></Grid><TextBlock Text="Move the slider to change rotation speed." FontSize="10" Foreground="#8292A8"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.Column="0" Background="#E0161E2A" CornerRadius="18" Padding="14" Margin="0,0,8,8"><StackPanel>
          <TextBlock Text="AUDIO ROUTING" FontSize="12" FontWeight="Bold" Foreground="#AEBBD0" Margin="0,0,0,14"/>
          <TextBlock Text="Capture from (virtual cable playback endpoint)" FontSize="11" Foreground="#AEBBD0" Margin="0,0,0,4"/><ComboBox x:Name="InputDeviceCombo"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <TextBlock Text="Output to (your earbuds / headphones)" FontSize="11" Foreground="#AEBBD0" Margin="0,7,0,4"/><ComboBox x:Name="OutputDeviceCombo"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <TextBlock Text="Tip: install VB-CABLE, then set its input/playback endpoint as Windows output." TextWrapping="Wrap" FontSize="10" Foreground="#8492A8" Margin="0,6,0,0"/>
          <Button x:Name="StartButton" Content="Start real-time 8D" Margin="0,8,0,0" Click="StartButton_Click"/>
          <Button x:Name="StopButton" Content="Stop engine" Background="#293344" Margin="0,5,0,0" Click="StopButton_Click" IsEnabled="False"/>
        </StackPanel></Border>
        <Border Grid.Row="0" Grid.Column="1" Background="#E0161E2A" CornerRadius="18" Padding="14" Margin="0,0,0,8"><StackPanel>
          <TextBlock Text="SPACE &amp; PRESETS" FontSize="12" FontWeight="Bold" Foreground="#AEBBD0" Margin="0,0,0,6"/>
          <TextBlock Text="ORBIT PROFILE" FontSize="10" FontWeight="SemiBold" Foreground="#AEBBD0" Margin="0,0,0,3"/>
          <ComboBox x:Name="PresetCombo" TextSearch.TextPath="Name" ToolTip="Choose a moving spatial profile."><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <TextBlock x:Name="PresetDescription" Text="Strong, continuous headphone movement with a clear but controlled Haas cue." FontSize="10" Foreground="#91A0B6" TextWrapping="Wrap" Margin="0,4,0,5"/>
          <TextBlock Text="LISTENING SPACE" FontSize="10" FontWeight="SemiBold" Foreground="#AEBBD0" Margin="0,0,0,3"/>
          <ComboBox x:Name="SoundSpaceCombo" TextSearch.TextPath="Name" ToolTip="Choose a headphone, speaker, hall or auditorium space."><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <TextBlock x:Name="SoundSpaceDescription" Text="Clear and close; room effects stay very subtle." FontSize="9" Foreground="#91A0B6" TextWrapping="Wrap" Margin="0,4,0,4"/>
          <TextBlock Text="ECHO AMOUNT (0-30%)" FontSize="10" FontWeight="SemiBold" Foreground="#AEBBD0" Margin="0,0,0,0"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><Slider x:Name="EchoSlider" Grid.Column="0" Minimum="0" Maximum="0.30" SmallChange="0.01" LargeChange="0.05" Value="0"/><TextBlock x:Name="EchoText" Grid.Column="1" Text="0%" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#8CC4FF"/></Grid>
          <TextBlock Text="REVERB AMOUNT (0-35%)" FontSize="10" FontWeight="SemiBold" Foreground="#AEBBD0" Margin="0,1,0,0"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><Slider x:Name="ReverbSlider" Grid.Column="0" Minimum="0" Maximum="0.35" SmallChange="0.01" LargeChange="0.05" Value="0.025"/><TextBlock x:Name="ReverbText" Grid.Column="1" Text="3%" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#8CC4FF"/></Grid>
        </StackPanel></Border>
        <Border Grid.Row="1" Grid.Column="0" Background="#E0161E2A" CornerRadius="18" Padding="14" Margin="0,0,8,0"><StackPanel>
          <TextBlock Text="SPATIAL SHAPING" FontSize="12" FontWeight="Bold" Foreground="#AEBBD0" Margin="0,0,0,4"/>
          <TextBlock Text="EFFECT BLEND" FontSize="11" FontWeight="SemiBold" Foreground="#AEBBD0"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions><Slider x:Name="BlendSlider" Grid.Column="0" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" Value="0.65"/><Border Grid.Column="1" Background="#222E3E" BorderBrush="#35465C" CornerRadius="10" Padding="8,5" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="BlendText" Text="65%" HorizontalAlignment="Center" Foreground="#8CC4FF" FontWeight="SemiBold"/></Border></Grid>
          <TextBlock Text="STEREO WIDTH" FontSize="11" FontWeight="SemiBold" Foreground="#AEBBD0" Margin="0,6,0,0"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions><Slider x:Name="WidthSlider" Grid.Column="0" Minimum="0.5" Maximum="1.5" SmallChange="0.01" LargeChange="0.05" Value="1.0"/><Border Grid.Column="1" Background="#222E3E" BorderBrush="#35465C" CornerRadius="10" Padding="8,5" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="WidthText" Text="100%" HorizontalAlignment="Center" Foreground="#8CC4FF" FontWeight="SemiBold"/></Border></Grid>
          <TextBlock Text="HAAS DELAY" FontSize="11" FontWeight="SemiBold" Foreground="#AEBBD0" Margin="0,6,0,0"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions><Slider x:Name="HaasDelaySlider" Grid.Column="0" Minimum="1" Maximum="12" SmallChange="0.1" LargeChange="1" Value="7"/><Border Grid.Column="1" Background="#222E3E" BorderBrush="#35465C" CornerRadius="10" Padding="8,5" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="HaasDelayText" Text="7.0 ms" HorizontalAlignment="Center" Foreground="#8CC4FF" FontWeight="SemiBold"/></Border></Grid>
          <TextBlock Text="HAAS LEVEL" FontSize="10" FontWeight="SemiBold" Foreground="#AEBBD0" Margin="0,3,0,0"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions><Slider x:Name="HaasLevelSlider" Grid.Column="0" Minimum="0" Maximum="0.5" SmallChange="0.01" LargeChange="0.05" Value="0.16"/><Border Grid.Column="1" Background="#222E3E" BorderBrush="#35465C" CornerRadius="10" Padding="8,5" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="HaasLevelText" Text="16%" HorizontalAlignment="Center" Foreground="#8CC4FF" FontWeight="SemiBold"/></Border></Grid>
          
        </StackPanel></Border>        <Border Grid.Row="1" Grid.Column="1" Background="#E0161E2A" CornerRadius="18" Padding="14"><StackPanel>
          <DockPanel><TextBlock Text="LIVE OUTPUT SIGNAL" FontSize="12" FontWeight="Bold" Foreground="#AEBBD0"/><TextBlock x:Name="LevelText" DockPanel.Dock="Right" Text="-ÃƒÆ’Ã‚Â¢Ãƒâ€¹Ã¢â‚¬Â Ãƒâ€¦Ã‚Â¾ dBFS" FontSize="11" Foreground="#69A7FF"/></DockPanel>
          <ProgressBar x:Name="LevelBar" Height="7" Minimum="0" Maximum="100" Value="0" Background="#263144" Foreground="#69A7FF" BorderThickness="0" Margin="0,14,0,8"/>
          <TextBlock Text="OUTPUT LEVEL" FontSize="10" FontWeight="SemiBold" Foreground="#AEBBD0" Margin="0,2,0,0"/><Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions><Slider x:Name="VolumeSlider" Grid.Column="0" Minimum="0.1" Maximum="1.0" SmallChange="0.01" LargeChange="0.05" Value="0.85"/><Border Grid.Column="1" Background="#222E3E" BorderBrush="#35465C" CornerRadius="10" Padding="8,5" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="VolumeText" Text="85%" HorizontalAlignment="Center" Foreground="#8CC4FF" FontWeight="SemiBold"/></Border></Grid>
          <TextBlock Text="OUTPUT LEVEL · LEVEL-REACTIVE VISUAL · NO FFT TELEMETRY" FontSize="9" FontWeight="SemiBold" Foreground="#8292A8" Margin="0,9,0,4"/>
          <Border Background="#101722" BorderBrush="#26364D" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,2,0,0">
            <Canvas x:Name="LevelVisualizerCanvas" Height="92" ClipToBounds="True" IsHitTestVisible="False"/>
          </Border>
          <TextBlock Text="Visualization follows the existing output peak meter; frequency bands are not available." FontSize="9" Foreground="#8492A8" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel></Border>

      </Grid></Grid><Grid Grid.Row="2" Margin="2,18,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="8D AURA  /  WINDOWS AUDIO ENGINE" FontSize="10" Foreground="#66758D"/><TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" Foreground="#FFD84D" Margin="12,0" Cursor="Hand"><Hyperlink NavigateUri="https://www.github.com/wadekarharshvardhan" RequestNavigate="DeveloperLink_RequestNavigate" Foreground="#FFD84D" TextDecorations="None">Developed By WADEKARHARSHVARDHAN</Hyperlink></TextBlock><TextBlock Grid.Column="2" Text="LIVE PROCESSING  /  NO FILE IMPORTS" FontSize="10" Foreground="#66758D" HorizontalAlignment="Right"/></Grid>
  </Grid></TabItem><TabItem Header="Equaliser">
      <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock Text="EQUALISER" FontSize="25" FontWeight="SemiBold" Foreground="#F3F6FB"/><TextBlock Text="Shape the tone before the spatial engine. Changes glide smoothly while audio is running." Margin="0,5,0,0" Foreground="#9BA9BC"/></StackPanel>
        <TabControl x:Name="EqModeTabs" Grid.Row="1" SelectedIndex="0" Background="#0A0C12">
          <TabItem Header="Basic">
            <StackPanel Margin="18" HorizontalAlignment="Stretch">
              <TextBlock Text="3-band tone" FontSize="19" FontWeight="SemiBold" Foreground="#F3F6FB" Margin="0,0,0,4"/>
              <TextBlock Text="Quick adjustments for the low, middle and high parts of the sound." Foreground="#9BA9BC" Margin="0,0,0,22"/>
              <Border Background="#151C27" BorderBrush="#263449" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="Bass" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#F3F6FB"/><Slider x:Name="BassEqSlider" Grid.Column="1" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" IsSnapToTickEnabled="False"/><TextBlock x:Name="BassEqText" Grid.Column="2" Text="0.0 dB" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#72B6FF"/></Grid></Border>
              <Border Background="#151C27" BorderBrush="#263449" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="Mid" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#F3F6FB"/><Slider x:Name="MidEqSlider" Grid.Column="1" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" IsSnapToTickEnabled="False"/><TextBlock x:Name="MidEqText" Grid.Column="2" Text="0.0 dB" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#72B6FF"/></Grid></Border>
              <Border Background="#151C27" BorderBrush="#263449" BorderThickness="1" CornerRadius="14" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="Treble" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#F3F6FB"/><Slider x:Name="TrebleEqSlider" Grid.Column="1" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" IsSnapToTickEnabled="False"/><TextBlock x:Name="TrebleEqText" Grid.Column="2" Text="0.0 dB" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#72B6FF"/></Grid></Border>
              <TextBlock Text="Range: ÃƒÂ¢Ã‹â€ Ã¢â‚¬â„¢12 to +12 dB Ãƒâ€šÃ‚Â· drag the thumb or click along the track" Foreground="#9BA9BC" Margin="0,18,0,0"/>
            </StackPanel>
          </TabItem>
          <TabItem Header="Advanced">
            <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,12"><CheckBox x:Name="EqEnabledCheckBox" Content="Equaliser enabled" Foreground="#F3F6FB" IsChecked="True" VerticalAlignment="Center"/><Button x:Name="EqResetButton" Content="Reset EQ" Click="EqResetButton_Click" HorizontalAlignment="Right" Padding="16,7"/></DockPanel>
              <Border Grid.Row="1" Background="#151C27" BorderBrush="#263449" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="Preamp" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#F3F6FB"/><Slider x:Name="PreampSlider" Grid.Column="1" Minimum="-12" Maximum="12" Value="0"/><TextBlock x:Name="PreampText" Grid.Column="2" Text="0.0 dB" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#72B6FF"/></Grid></Border>
              <UniformGrid Grid.Row="2" x:Name="AdvancedBandsPanel" Columns="2"/>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </TabItem></TabControl>
</Window>




















