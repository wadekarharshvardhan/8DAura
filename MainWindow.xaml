            <Ellipse Canvas.Left="130" Canvas.Top="100" Width="240" Height="240" Stroke="#26354F" StrokeThickness="1"/>
            <Ellipse Canvas.Left="76" Canvas.Top="46" Width="348" Height="348" Stroke="#4765A0" StrokeThickness="0.8" StrokeDashArray="1 4" Opacity="0.46"/>
            <Ellipse Canvas.Left="97" Canvas.Top="157" Width="306" Height="126" Stroke="#5B69CE" StrokeThickness="1.3" Opacity="0.65" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-24"/></Ellipse.RenderTransform></Ellipse>
            <Ellipse Canvas.Left="145" Canvas.Top="80" Width="210" Height="280" Stroke="#287FA4" StrokeThickness="1.1" Opacity="0.48" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="30"/></Ellipse.RenderTransform></Ellipse>
            <Line X1="250" Y1="18" X2="250" Y2="422" Stroke="#273448" StrokeThickness="1"/>
            <Line X1="48" Y1="220" X2="452" Y2="220" Stroke="#273448" StrokeThickness="1"/>
            <TextBlock Canvas.Left="239" Canvas.Top="2" Text="FRONT" FontSize="10" Foreground="#8294AF"/>
            <TextBlock Canvas.Left="242" Canvas.Top="424" Text="REAR" FontSize="10" Foreground="#8294AF"/>
            <TextBlock Canvas.Left="10" Canvas.Top="214" Text="L" FontSize="10" Foreground="#8294AF"/>
            <TextBlock Canvas.Left="474" Canvas.Top="214" Text="R" FontSize="10" Foreground="#8294AF"/>
            <Ellipse x:Name="OrbHalo" Canvas.Left="174" Canvas.Top="144" Width="152" Height="152" Fill="#392B88" Opacity="0.16" IsHitTestVisible="False"/>
            <Ellipse Canvas.Left="190" Canvas.Top="160" Width="120" Height="120" Fill="#151F38" Stroke="#426FC0" StrokeThickness="1.5" IsHitTestVisible="False"><Ellipse.Effect><DropShadowEffect Color="#6D53FF" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/></Ellipse.Effect></Ellipse>
            <Ellipse x:Name="OrbCore" Canvas.Left="201" Canvas.Top="171" Width="98" Height="98" Stroke="#72C5FF" StrokeThickness="1.8" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush Center="0.38,0.3" RadiusX="0.8" RadiusY="0.8"><GradientStop Color="#7B6BFF" Offset="0"/><GradientStop Color="#27598E" Offset="0.48"/><GradientStop Color="#14223B" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.Effect><DropShadowEffect Color="#38BFFF" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/></Ellipse.Effect></Ellipse>
