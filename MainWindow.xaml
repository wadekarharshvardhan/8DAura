<Window x:Class="EightDAura.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="8D Aura" Icon="logo/logo.ico" Height="900" Width="1440" MinHeight="720" MinWidth="1024" WindowStartupLocation="CenterScreen" WindowState="Maximized" FontFamily="Segoe UI Variable" Background="{StaticResource BgBrush}" Closing="Window_Closing">
  <TabControl x:Name="MainTabs" Margin="10" Background="#0A0C12"><TabItem Header="Spatial Audio"><Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,22">
